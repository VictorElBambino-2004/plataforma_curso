<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "Plataforma Cursos" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="application-name" content="Plataforma Cursos">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <%# Enable PWA manifest for installable apps (make sure to enable in config/routes.rb too!) %>
    <%#= tag.link rel: "manifest", href: pwa_manifest_path(format: :json) %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <!-- CDN Moderno de Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <%# Includes all stylesheet files in app/assets/stylesheets %>
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="bg-slate-50 text-slate-800 antialiased min-h-screen flex flex-col">
    
    <!-- Barra de Navegación Superior Moderna -->
    <header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-sm">
      <div class="max-w-6xl mx-auto px-6 h-16 flex items-center justify-between">
        <h2 class="text-xl font-extrabold text-slate-900 tracking-tight">
          <%= link_to "Plataforma de Cursos", courses_path, class: "hover:text-indigo-600 transition" %>
        </h2>
        <nav class="flex items-center gap-4">
          <%= link_to "Catálogo", courses_path, class: "text-sm font-medium text-slate-600 hover:text-indigo-600 transition" %>
        </nav>
      </div>
    </header>

    <!-- Sistema de Alertas Flotantes (Toasts) -->
    <% if notice.present? || alert.present? %>
      <div class="fixed bottom-6 right-6 z-50 flex flex-col gap-2 max-w-sm w-full">
        <% if notice.present? %>
          <div class="bg-emerald-600 text-white px-5 py-3 rounded-xl shadow-xl flex items-center justify-between text-sm font-medium">
            <span><%= notice %></span>
            <button onclick="this.parentElement.remove()" class="text-emerald-200 hover:text-white ml-3 text-lg font-bold">&times;</button>
          </div>
        <% end %>
        <% if alert.present? %>
          <div class="bg-rose-600 text-white px-5 py-3 rounded-xl shadow-xl flex items-center justify-between text-sm font-medium">
            <span><%= alert %></span>
            <button onclick="this.parentElement.remove()" class="text-rose-200 hover:text-white ml-3 text-lg font-bold">&times;</button>
          </div>
        <% end %>
      </div>
    <% end %>

    <!-- Contenido Principal -->
    <main class="max-w-6xl mx-auto px-6 py-10 flex-grow w-full">
      <%= yield %>
    </main>

  </body>
</html>